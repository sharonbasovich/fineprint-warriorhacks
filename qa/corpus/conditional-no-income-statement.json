{
  "id": "conditional-no-income-statement",
  "description": "A leading \"If no one...\" clause gates the document AND the document name must be preserved in the title.",
  "input": {
    "kind": "text",
    "text": "CEDAR COUNTY BENEFITS\nIt is time to renew your benefits.\nThe benefits you need to renew have a check-mark next to them:\n[x] SNAP\nItems we need from you: send copies.\n\u2022 If no one in your home has income, sign the No Income Statement.\n\u2022 Proof of income: last 4 pay stubs."
  },
  "expect": {
    "items": [
      {
        "category": "documents",
        "status": "conditional",
        "titleContains": "No Income Statement"
      },
      {
        "category": "documents",
        "status": "info",
        "titleContains": "Proof of income"
      }
    ],
    "forbidden": [
      {
        "category": "dates",
        "titleContains": "Respond by"
      },
      {
        "category": "dates",
        "titleContains": "Respond within"
      },
      {
        "category": "dates",
        "titleContains": "Deadline:"
      },
      {
        "category": "dates",
        "titleContains": "not stated in this notice"
      },
      {
        "category": "dates",
        "titleContains": "Past date"
      },
      {
        "category": "dates",
        "titleContains": "Letter printed"
      },
      {
        "category": "dates",
        "titleContains": "Processing window"
      }
    ]
  }
}